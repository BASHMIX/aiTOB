# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Start.gg Configuration
STARTGG_API_TOKEN=your_startgg_token_here

# Challonge OAuth (optional; preferred over the legacy v1 key)
CHALLONGE_OAUTH_CLIENT_ID=your_challonge_oauth_client_id_here
CHALLONGE_OAUTH_CLIENT_SECRET=your_challonge_oauth_client_secret_here
CHALLONGE_OAUTH_REDIRECT_URI=https://your-public-host/api/auth/challonge/callback

# Provider product rollout flags.
CHALLONGE_READ_ENABLED=false
CHALLONGE_LOCAL_WORKFLOW_ENABLED=false
CHALLONGE_SCORE_COMMANDS_ENABLED=false
CHALLONGE_DQ_COMMANDS_ENABLED=false

# Tournament Setup rollout gates — all disabled by default. Enable them in this
# order only after the feature-003 workspace/PostgreSQL and no-automatic-DQ
# gates pass: wizard drafts, local activation, registration, then confirmed
# remote provider starts. The provider-start gate covers both Start.gg and
# Challonge and must remain off until each adapter has an authorized contract.
TOURNAMENT_SETUP_WIZARD_ENABLED=false
TOURNAMENT_ACTIVATION_ENABLED=false
TOURNAMENT_REGISTRATION_ENABLED=false
PROVIDER_START_ENABLED=false

# Google Gemini Configuration (AI Referee & Safety)
GOOGLE_API_KEY=your_google_api_key_here

# Database Configuration
# PostgreSQL is the only supported database. Hosted environments should inject
# this value from their secret manager.
DATABASE_URL=postgresql://aitob:CHANGE_ME@127.0.0.1:5433/aitob
POSTGRES_PASSWORD=CHANGE_ME
APP_PUBLIC_URL=http://127.0.0.1:5173

# Account email delivery. Resend is selected when both values are configured;
# otherwise provide the complete SMTP set. Secrets are injected at runtime and
# never returned by the API.
RESEND_API_KEY=
EMAIL_FROM=
# Optional Web Push/VAPID settings. These are inert until a push subscription
# and sender implementation is enabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Initial owner bootstrap — used only when the users table is empty. Remove
# the two credential values after first sign-in; the UI uses an HttpOnly session.
AITOB_BOOTSTRAP_OWNER_EMAIL=owner@example.com
AITOB_BOOTSTRAP_OWNER_PASSWORD=replace_with_a_unique_12_character_minimum_password
AITOB_BOOTSTRAP_OWNER_NAME=Primary organizer
AITOB_BOOTSTRAP_WORKSPACE_NAME=Primary organizer workspace
AITOB_SESSION_TTL_HOURS=12
# Independent Fernet key for encrypted TOTP setup material. Keep outside the
# database and generate with `Fernet.generate_key()`; never reuse provider keys.
AITOB_AUTH_MASTER_KEY=
# Independent service-level Fernet key for provider/Discord integration
# credentials. Keep outside the database and do not reuse the auth key.
AITOB_INTEGRATION_MASTER_KEY=
# Independent service-level Fernet key for the AI provider credential store.
AITOB_AI_SERVICE_MASTER_KEY=
# Set true only behind HTTPS.
AITOB_SESSION_COOKIE_SECURE=false
# Temporary old-client bridge; disabled by default and owner-workspace-only.
AITOB_LEGACY_HUB_PASSWORD_COMPAT=false
# HUB_PASSWORD is only read while the temporary bridge is explicitly enabled.
HUB_PASSWORD=
# Registration is implemented but stays closed until tenant-isolation acceptance.
ALLOW_PUBLIC_REGISTRATION=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration
# Comma-separated list of browser origins allowed to call the API.
# Leave empty for local dev (falls back to localhost:5173 / localhost:8000).
# Production example: https://hub.mydomain.com,https://overlays.mydomain.com
ALLOWED_ORIGINS=
# Optional: regex to allow a whole subdomain space (cloud-hosted OBS overlays).
# Example: https://.*\.mydomain\.com
ALLOWED_ORIGIN_REGEX=
