# Phase-10 acceptance environment only. Copy locally to .env.acceptance; never commit secrets.
ACCEPTANCE_ENVIRONMENT=true
DATABASE_URL=postgresql://aitob_acceptance:CHANGE_ME@127.0.0.1:5433/aitob_acceptance
HOST=127.0.0.1
PORT=8001
# Phase-10 scripts still authenticate through the explicit compatibility bridge.
# Do not enable this setting in a normal deployment.
AITOB_LEGACY_HUB_PASSWORD_COMPAT=true
HUB_PASSWORD=admin

# Defaults stay dark. The acceptance runner enables one cumulative stage at a time.
CHALLONGE_READ_ENABLED=false
CHALLONGE_LOCAL_WORKFLOW_ENABLED=false
CHALLONGE_SCORE_COMMANDS_ENABLED=false
CHALLONGE_DQ_COMMANDS_ENABLED=false
ALLOW_PUBLIC_REGISTRATION=false

# Account credentials and test destinations are entered through Admin →
# Integration Accounts and are encrypted in the acceptance database. This file stores
# service-only settings, never provider or Discord credentials.
