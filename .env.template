# AI Tournament Organizer Bot — Environment Variables
# Copy this file to .env and fill in your values.

# ── Discord ────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# ── Start.gg ───────────────────────────────────────────────────────────
# OAuth credentials (for player linking via /login)
STARTGG_CLIENT_ID=your_startgg_client_id_here
STARTGG_CLIENT_SECRET=your_startgg_client_secret_here

# Static API token (for tournament data queries — from start.gg developer settings)
STARTGG_API_TOKEN=your_startgg_api_token_here

# ── Google Gemini (for AI match result parsing) ────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── API Configuration ──────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── Challonge OAuth ─────────────────────────────────────────────────────
# Register the exact HTTPS callback URL in Challonge Connect. Do not expose
# the client secret or issued tokens to the browser.
CHALLONGE_OAUTH_CLIENT_ID=your_challonge_oauth_client_id_here
CHALLONGE_OAUTH_CLIENT_SECRET=your_challonge_oauth_client_secret_here
CHALLONGE_OAUTH_REDIRECT_URI=https://your-public-host/api/auth/challonge/callback

# Provider-isolation migration flags — keep all false until their rollout checkpoint.
PROVIDER_V2_CONTRACTS_ENABLED=false
PROVIDER_COORDINATOR_ENABLED=false
CHALLONGE_READ_ENABLED=false
CHALLONGE_LOCAL_WORKFLOW_ENABLED=false
CHALLONGE_SCORE_COMMANDS_ENABLED=false
CHALLONGE_DQ_COMMANDS_ENABLED=false
AITOB_LEGACY_PROVIDER_FALLBACK=false

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
# Leave empty for local dev (falls back to localhost:5173 / localhost:8000).
# Production example: https://hub.mydomain.com,https://overlays.mydomain.com
ALLOWED_ORIGINS=
# Optional: regex to allow a whole subdomain space (cloud-hosted OBS overlays).
# Example: https://.*\.mydomain\.com
ALLOWED_ORIGIN_REGEX=

# ── Database ───────────────────────────────────────────────────────────
DB_PATH=backend/core/database.sqlite

# ── Initial owner session bootstrap ─────────────────────────────────────
# Used exactly once when no user exists. Remove the credential values after
# first sign-in. There is no public registration or default admin account.
AITOB_BOOTSTRAP_OWNER_EMAIL=owner@example.com
AITOB_BOOTSTRAP_OWNER_PASSWORD=replace_with_a_unique_12_character_minimum_password
AITOB_BOOTSTRAP_OWNER_NAME=Primary organizer
AITOB_BOOTSTRAP_WORKSPACE_NAME=Primary organizer workspace
AITOB_SESSION_TTL_HOURS=12
AITOB_SESSION_COOKIE_SECURE=false
# Independent service-level Fernet key for encrypted MFA/TOTP secrets.
AITOB_AUTH_MASTER_KEY=
# Independent service-level Fernet key for provider/Discord integration
# credentials. Keep outside the database and do not reuse the auth key.
AITOB_INTEGRATION_MASTER_KEY=
# Independent service-level Fernet key for the AI provider credential store.
AITOB_AI_SERVICE_MASTER_KEY=
# Old local clients only; off by default, and mapped to the sole Owner workspace.
AITOB_LEGACY_HUB_PASSWORD_COMPAT=false
HUB_PASSWORD=
ALLOW_PUBLIC_REGISTRATION=false
